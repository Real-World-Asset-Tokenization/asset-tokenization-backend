# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
PORT=5001

# Browser origin(s) allowed to call the API (comma separated). Required in production.
FRONTEND_URL=https://app.example.com
# Set to the number of reverse proxies in front of the API (1 for one load balancer) so rate limiting sees real client IPs.
TRUST_PROXY=1

# At least 32 random characters. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production with a short or guessable value.
JWT_SECRET=
# Optional, default 8h
JWT_EXPIRES_IN=8h

MONGO_URI=

AI_SERVICE_URL=http://127.0.0.1:5002

BLOCKCHAIN_RPC_URL=
# Fresh keys only. Never use a Hardhat/Anvil test key on a real network.
DEPLOYER_PRIVATE_KEY=
VALUATION_PUBLISHER_PRIVATE_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Demo endpoints (faucet, direct buy, swap) are off whenever NODE_ENV=production. Do not enable them there.
# ENABLE_DEMO_ENDPOINTS=false
